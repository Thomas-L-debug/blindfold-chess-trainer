# Normalize text files to LF in the repo and on checkout.
# Overrides core.autocrlf so Windows stops reporting empty "modified" diffs.
* text=auto eol=lf

# cmd.exe batch files need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell / Gradle wrapper stay LF (and executable in the index)
*.sh text eol=lf
gradlew text eol=lf

# Never convert binaries
*.jar binary
*.apk binary
*.aab binary
*.so binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.keystore binary
*.jks binary
