# Copy to keystore.properties (gitignored) after creating the upload keystore.
# Never commit keystore.properties, *.jks, or *.keystore.
#
#   powershell -ExecutionPolicy Bypass -File .\scripts\create-upload-keystore.ps1
#
storeFile=keystore/upload-keystore.jks
storePassword=REPLACE_ME
keyAlias=upload
keyPassword=REPLACE_ME
